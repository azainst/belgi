@echo off
rem Ждёт, пока сервер реально ответит на /healthz, и только потом открывает браузер.
rem Работает в фоне рядом с сервером — вместо того чтобы открывать браузер через
rem фиксированную паузу и гадать, успел сервер стартовать или нет.
set /a n=0
:loop
set /a n+=1
curl -s -o nul http://127.0.0.1:8000/healthz
if not errorlevel 1 (
  start http://127.0.0.1:8000
  exit /b 0
)
if %n% GEQ 60 (
  echo Сервер не ответил за 60 секунд. Откройте http://127.0.0.1:8000 вручную,
  echo или пришлите мне то, что написано в этом окне.
  exit /b 1
)
timeout /t 1 /nobreak >nul
goto loop
